# Local development only
POSTGRES_DB=tenderhive
POSTGRES_USER=tenderhive
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_HOST_PORT=5432

NEO4J_PASSWORD=local-neo4j-password
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
QDRANT_HOST_PORT=6333
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092

# Optional monitoring profile
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-password

# Optional th-modelgw profile. Supply a NVIDIA key, risk model and masking key in .env.
NVIDIA_API_KEY=
MODEL_RISK=
MODEL_GW_MASKING_KEY=
MODEL_GW_POSTGRES_DSN=postgresql://tenderhive:local-postgres-password@postgres:5432/tenderhive
MODEL_GW_HOST_PORT=8001
MODEL_GW_PORT=8000

# Optional th-eval API profile.
TH_EVAL_POSTGRES_DSN=postgresql://tenderhive:local-postgres-password@postgres:5432/tenderhive
TH_EVAL_HOST_PORT=8002
TH_EVAL_PORT=8000
