TH_EVAL_DATASET_PATH=datasets/risk-v1.jsonl
TH_EVAL_FIXTURE_PATH=fixtures/risk-v1.jsonl
TH_EVAL_REPORT_DIR=reports
TH_EVAL_GATEWAY_URL=http://th-modelgw:8000
TH_EVAL_PROMPT_VERSION=v1
TH_EVAL_MODEL_LABEL=modelgw-configured
TH_EVAL_TIMEOUT_SECONDS=120
TH_EVAL_CONCURRENCY=2
TH_EVAL_REPEATS=1
TH_EVAL_MAX_ATTEMPTS=40
TH_EVAL_ECE_BUCKETS=10
# Optional project acceptance threshold, blank means the gate is not configured.
TH_EVAL_MIN_RISK_MACRO_F1=
# Optional OTLP/HTTP metrics URL, e.g. http://otel-collector:4318/v1/metrics in Compose.
TH_EVAL_OTLP_METRICS_URL=
TH_EVAL_OTLP_TIMEOUT_SECONDS=5
# PostgreSQL is only required for migrate, serve and healthcheck.
TH_EVAL_POSTGRES_DSN=postgresql://th_eval:local_eval_password@127.0.0.1:5432/th_eval
TH_EVAL_DATABASE_TIMEOUT_SECONDS=10
TH_EVAL_BIND_HOST=127.0.0.1
TH_EVAL_PORT=8004
TH_EVAL_API_MODE=fixture
TH_EVAL_KB_VERSION=kb-eval-v1
TH_EVAL_SOLVER_URL=http://th-solver:8000
TH_EVAL_KB_EVAL_TOKEN=local-demo-kb-eval-token
TH_EVAL_ORCHESTRATOR_URL=http://th-orchestrator:8000
TH_EVAL_ORCHESTRATOR_TOKEN=local-orchestrator-service-token
