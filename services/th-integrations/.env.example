# Local development only. This mailbox belongs to the Compose GreenMail sandbox.
TH_INTEGRATIONS_MAILBOX_ID=demo-mailbox
TH_INTEGRATIONS_IMAP__HOST=mail-sandbox
TH_INTEGRATIONS_IMAP__PORT=3143
TH_INTEGRATIONS_IMAP__USER=demo@example.test
TH_INTEGRATIONS_IMAP__PASSWORD=demo-mail-only
TH_INTEGRATIONS_IMAP__FOLDER=INBOX
TH_INTEGRATIONS_IMAP__ENCRYPTION=plaintext
TH_INTEGRATIONS_EXCHANGE=null
TH_INTEGRATIONS_MAIL_POLL_SECONDS=2
TH_INTEGRATIONS_MAIL_TIMEOUT_SECONDS=5
TH_INTEGRATIONS_MAX_MESSAGE_BYTES=16777216
TH_INTEGRATIONS_MAX_ATTACHMENT_BYTES=8388608

TH_INTEGRATIONS_DATABASE_DSN=postgresql://tenderhive:local-postgres-password@postgres:5432/tenderhive
TH_INTEGRATIONS_DATABASE_TIMEOUT_SECONDS=5
TH_INTEGRATIONS_DATABASE_MAX_CONNECTIONS=4
TH_INTEGRATIONS_REDIS_URL=redis://redis:6379/0
TH_INTEGRATIONS_KAFKA_BROKERS=["kafka:29092"]
TH_INTEGRATIONS_IO_TIMEOUT_SECONDS=5
TH_INTEGRATIONS_OUTBOX_POLL_SECONDS=1
TH_INTEGRATIONS_OUTBOX_BATCH_SIZE=25
TH_INTEGRATIONS_OUTBOX_LEASE_SECONDS=15

TH_INTEGRATIONS_KB_VERSION=kb-demo-v1
TH_INTEGRATIONS_PROFILE_REF=demo-profile
TH_INTEGRATIONS_DOCUMENT_BASE_URL=http://th-integrations:8000
TH_INTEGRATIONS_DOCUMENT_TOKEN=demo-integrations-document-token
TH_INTEGRATIONS_MCP_ALLOWED_HOSTS=["th-integrations:*","127.0.0.1:*","localhost:*"]
TH_INTEGRATIONS_MCP_ALLOWED_ORIGINS=[]
TH_INTEGRATIONS_BIND_HOST=0.0.0.0
TH_INTEGRATIONS_PORT=8000
TH_INTEGRATIONS_OTLP_TRACES_ENDPOINT=null
TH_INTEGRATIONS_LOG_LEVEL=INFO
