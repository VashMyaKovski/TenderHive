TH_AGENTS_MODEL_GATEWAY_URL=http://th-modelgw:8000
TH_AGENTS_MODEL_GATEWAY_TIMEOUT_SECONDS=120
TH_AGENTS_PUBLIC_URL=http://th-agents:8000
TH_AGENTS_BIND_HOST=0.0.0.0
TH_AGENTS_PORT=8000
TH_AGENTS_REDIS_URL=redis://redis:6379/0
TH_AGENTS_REDIS_TIMEOUT_SECONDS=0.5
TH_AGENTS_TASK_TTL_SECONDS=86400
TH_AGENTS_TASK_LEASE_SECONDS=130
TH_AGENTS_TASK_WAIT_SECONDS=5
TH_AGENTS_TASK_POLL_SECONDS=0.2
TH_AGENTS_KAFKA_BROKERS=["kafka:29092"]
TH_AGENTS_COMPLETION_POLL_SECONDS=0.2
TH_AGENTS_COMPLETION_TIMEOUT_SECONDS=5
TH_AGENTS_ARTIFACT_ROOT=/var/lib/tenderhive/artifacts
TH_AGENTS_PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
TH_AGENTS_ARTIFACT_TOKEN=replace-with-local-demo-token
