# Compose development values. Keep secrets in services/th-kb/.env or inject them.
KB_POSTGRES_DSN=postgresql://tenderhive:local-postgres-password@postgres:5432/tenderhive
KB_NEO4J_URI=bolt://neo4j:7687
KB_NEO4J_USER=neo4j
KB_NEO4J_PASSWORD=local-neo4j-password
KB_NEO4J_DATABASE=neo4j
KB_QDRANT_URL=http://qdrant:6333
KB_QDRANT_COLLECTION=th_kb_context
# Optional. Leave blank for local Qdrant without authentication.
KB_QDRANT_API_KEY=
# Optional. A blank value disables Redis.
KB_REDIS_URL=redis://redis:6379/1
KB_EVAL_URL=http://th-eval-api:8000
KB_EVAL_TOKEN=local-demo-kb-eval-token
KB_TEST_SET_VERSION=kb-regression-v1
# Fixture mode is for public or synthetic local demonstrations. Use gateway for live embeddings.
KB_EMBEDDING_MODE=fixture
KB_MODEL_GW_URL=http://th-modelgw:8000
KB_MODEL_GW_PROMPT_VERSION=v1
KB_VECTOR_SIZE=256
KB_DATABASE_TIMEOUT_SECONDS=5
KB_IO_TIMEOUT_SECONDS=10
KB_EVAL_TIMEOUT_SECONDS=60
KB_CACHE_TTL_SECONDS=30
KB_MAX_FRAGMENTS=10
KB_BIND_HOST=0.0.0.0
KB_PORT=8000
