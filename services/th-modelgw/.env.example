# Set MODEL_GW_POSTGRES_DSN for the local journal. Fill the provider and masking keys to enable a model.
MODEL_GW_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_API_KEY=
OPENROUTER_MODEL_TEST=
# Use openai/text-embedding-3-small for demo embeddings.
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_VISION_MODEL=
# NVIDIA settings apply only when MODEL_GW_PROVIDER=nvidia.
NVIDIA_API_KEY=
MODEL_GW_MASKING_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/
MODEL_RISK=
# Empty model IDs disable the tasks. Configure input_type for models that require it.
MODEL_EMBEDDING=
MODEL_VLM=
MODEL_GW_EMBEDDING_INPUT_TYPE=passage
MODEL_GW_PROMPT_VERSION=v1
MODEL_GW_DB_TIMEOUT_SECONDS=3
PII_MASKING_ENABLED=true
LOG_LEVEL=INFO
# Set an OTLP/HTTP trace endpoint to enable export.
MODEL_GW_OTLP_ENDPOINT=
MODEL_GW_OTLP_TIMEOUT_SECONDS=3
MODEL_GW_CONFIDENCE_FLOOR=0.65
MODEL_GW_TIMEOUT_SECONDS=35
MODEL_GW_MAX_RETRIES=2
MODEL_GW_RETRY_DELAY_SECONDS=0.5
MODEL_GW_MAX_COMPLETION_TOKENS=2048
MODEL_GW_REDIS_URL=redis://redis:6379/0
MODEL_GW_REDIS_TIMEOUT_SECONDS=0.5
MODEL_GW_CACHE_TTL_SECONDS=1800
MODEL_GW_BIND_HOST=0.0.0.0
MODEL_GW_PORT=8000
