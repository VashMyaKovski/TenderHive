# Local service defaults. Models for embeddings and vision are optional.
MODEL_GW_OPENROUTER_URL=https://openrouter.ai/api/v1/
# Local testing with OpenRouter routes that require data collection. Only synthetic_text is eligible.
MODEL_GW_SYNTHETIC_PROVIDER_COLLECTION=true
MODEL_GW_EMBEDDINGS_MODEL=
MODEL_GW_VISION_MODEL=
MODEL_GW_PROMPT_VERSION=v1
MODEL_GW_CONFIDENCE_FLOOR=0.65
MODEL_GW_TIMEOUT_SECONDS=35
MODEL_GW_MAX_RETRIES=2
MODEL_GW_RETRY_DELAY_SECONDS=0.5
MODEL_GW_MAX_COMPLETION_TOKENS=2048
MODEL_GW_REDIS_URL=redis://redis:6379/0
MODEL_GW_REDIS_TIMEOUT_SECONDS=0.5
MODEL_GW_CACHE_TTL_SECONDS=1800
MODEL_GW_BIND_HOST=0.0.0.0
MODEL_GW_PORT=8000
