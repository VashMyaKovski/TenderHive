# th-gateway: локальная конфигурация. Скопируйте файл в .env рядом с этим.
# Пустой POSTGRES_DSN включает демонстрационный режим на хранилище в памяти,
# пустой KAFKA_BROKERS заменяет публикацию журналом, пустой токен выключает бота.
POSTGRES_DSN=
KAFKA_BROKERS=

# Зарезервировано для оркестратора: шлюз Redis не использует.
REDIS_URL=

TELEGRAM_BOT_TOKEN=
JWT_SECRET=local-jwt-secret-change-me-32-symbols
JWT_TTL_HOURS=8
SERVICE_API_KEY=orchestrator-dev-key
HITL_TIMEOUT_HOURS=24
HITL_SWEEP_SECONDS=5
ARTIFACT_BUCKET=./data/artifacts
ARTIFACT_LINK_TTL_MINUTES=10
DEMO_PASSWORD=tenderhive
MAX_UPLOAD_MB=32
GATEWAY_PUBLIC_URL=http://127.0.0.1:8080
OUTBOX_POLL_SECONDS=2
DELIVERY_POLL_SECONDS=5

# Внутренний Workbench и файл доступа для профиля дашборда. Задаются вместе.
DEMO_WORKBENCH_URL=
DEMO_WORKBENCH_TOKEN=
DEMO_ACCESS_GRANTS_FILE=
