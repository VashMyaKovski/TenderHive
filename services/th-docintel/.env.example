DOCINTEL_GRPC_TIMEOUT_SECONDS=30
DOCINTEL_GRPC_MAX_MESSAGE_BYTES=67108864
DOCINTEL_MAX_FILE_MB=32
DOCINTEL_MAX_UNCOMPRESSED_MB=128
